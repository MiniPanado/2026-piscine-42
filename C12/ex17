#include "ft_list.h"

void	ft_sorted_list_merge(t_list **begin_list1, t_list *begin_list2, int (*cmp)())
{
	t_list	**current1;
	t_list	*current2;
	t_list	*next2;

	if (!begin_list1 || !cmp)
		return ;
	if (!begin_list2)
		return ;
	if (!*begin_list1)
	{
		*begin_list1 = begin_list2;
		return ;
	}
	current1 = begin_list1;
	current2 = begin_list2;
	while (*current1 && current2)
	{
		next2 = current2->next; // salva o próximo da lista 2
		if (cmp(current2->data, (*current1)->data) < 0)
		{
			// Insere current2 antes de *current1
			current2->next = *current1;
			*current1 = current2;
			current2 = next2;
			current1 = &(*current1)->next;
		}
		else
		{
			// Avança na lista 1
			current1 = &(*current1)->next;
		}
	}
	if (current2)
		*current1 = current2;
}