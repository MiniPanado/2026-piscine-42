#include <unistd.h>

static void	ft_print_hex(long nb)
{
	if (nb < 0)
	{
		nb = -nb;
	}
	if (nb > 16)
	{
		ft_print_hex(nb >> 4);
	}
	write(1, &"0123456789abcdef"[nb & 0xF], 1);
}

